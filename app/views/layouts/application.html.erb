<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : "ClinicaApp" %></title>
    <%= csrf_meta_tags %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <a class="navbar-brand" href="/">ClinicaApp</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">

            <li class="nav-item">
              <%= link_to "Dashboard", root_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Pacientes", pacientes_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Prestadores", prestadores_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Atendimentos", atendimentos_path, class: "nav-link" %>
            </li>

          </ul>
          <div class="d-flex">

            <% if authenticated? %>

              <%= button_to "Sair",
                    session_path,
                    method: :delete,
                    class: "btn btn-outline-light" %>

            <% else %>

              <%= link_to "Entrar",
                    new_session_path,
                    class: "btn btn-outline-light me-2" %>

              <%= link_to "Cadastrar",
                    new_registration_path,
                    class: "btn btn-light" %>

            <% end %>

          </div>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <%= bootstrap_flash %>
      <%= yield %>

    </div>

    <%= javascript_include_tag "twitter/bootstrap/bootstrap.bundle.min" %>
  </body>
</html>
