<div id="<%= dom_id paciente %>">
  <div>
    <strong>Nome completo:</strong>
    <%= paciente.nome_completo %>
  </div>

  <div>
    <strong>Data nascimento:</strong>
    <%= paciente.data_nascimento %>
  </div>

  <div>
    <strong>Cpf:</strong>
    <%= paciente.cpf %>
  </div>

  <div>
    <strong>Telefone:</strong>
    <%= paciente.telefone %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= paciente.email %>
  </div>

  <div>
    <strong>Endereco:</strong>
    <%= paciente.endereco %>
  </div>

</div>
