<p style="color: green"><%= notice %></p>

<%= render @atendimento %>

<div>
  <%= link_to "Edit this atendimento", edit_atendimento_path(@atendimento) %> |
  <%= link_to "Back to atendimentos", atendimentos_path %>

  <%= button_to "Destroy this atendimento", @atendimento, method: :delete %>
</div>

<% unless @atendimento.cancelada? %>
  <%= button_to "Cancelar atendimento",
      cancelar_atendimento_path(@atendimento),
      method: :patch,
      data: {
        turbo_confirm: "Deseja cancelar este atendimento?"
      } %>
<% end %>