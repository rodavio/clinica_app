<p style="color: green"><%= notice %></p>

<% content_for :title, "prestadores" %>

<h1>Prestadores</h1>

<div id="prestadores">
  <% @prestadores.each do |prestador| %>
    <%= render prestador %>
    <p>
      <%= link_to "Show this prestador", prestador %>
    </p>
  <% end %>
</div>

<%= link_to "New prestador", new_prestador_path %>
